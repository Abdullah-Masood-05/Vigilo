/src-tauri/target
/src-tauri/gen
/snapshots

# Model weights are bundled at build time, not committed. See README.md.
/models/*.onnx

# Local tooling
/.claude/
CLAUDE.md

# macOS metadata
.DS_Store

# Screenshots may contain a real person.
*.png
!src-tauri/icons/*.png

# Diagnostic runs. A `Signals` recording is a real person's face geometry, head
# pose and gaze over time — same reasoning as the screenshot rule above. Scoped
# to the scratch location so a deliberate replay fixture can still be added.
/src-tauri/*.jsonl
/src-tauri/diag.toml

# bun/npm only ever install the Tauri CLI here; the front end has no deps.
/node_modules

# ffmpeg is a custom minimal build (~1.7 MB, camera capture only — no
# ffprobe, no DLLs, statically linked), committed via git-lfs rather than
# downloaded at build time. See rust_context.md §22 for why: unlike the model
# weights above, this is small enough and specific enough to this project's
# capture path that fetching a generic prebuilt release would defeat the
# point of building it minimal in the first place. `ffmpeg/ffmpeg.exe` is
# therefore intentionally NOT listed here.
