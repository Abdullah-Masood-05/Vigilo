/src-tauri/target
/src-tauri/gen
/snapshots
/*.exe
/*.msi
/dist-installers/

# Model weights are bundled at build time, not committed. See README.md.
/models/*.onnx

# Local tooling
/.claude/
CLAUDE.md

# Screenshots may contain a real person.
*.png
!src-tauri/icons/*.png

# Diagnostic runs. A `Signals` recording is a real person's face geometry, head
# pose and gaze over time — same reasoning as the screenshot rule above. Scoped
# to the scratch location so a deliberate replay fixture can still be added.
/src-tauri/*.jsonl
/src-tauri/diag.toml

# bun/npm only ever install the Tauri CLI here; the front end has no deps.
/node_modules

# ffmpeg is a custom minimal build, one binary per OS, published by
# Abdullah-Masood-05/ffmpeg-minimal-build and downloaded at build time (CI does
# it; see README "ffmpeg" for a local checkout). Only its licence is committed.
/ffmpeg/ffmpeg
/ffmpeg/ffmpeg.exe
