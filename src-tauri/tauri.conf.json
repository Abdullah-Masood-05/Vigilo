{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vigilo",
  "version": "0.1.0",
  "identifier": "com.vigilo.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vigilo",
        "width": 1340,
        "height": 880,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["../models/*.onnx", "../ffmpeg/*", "../README-TESTER.txt"]
  }
}
