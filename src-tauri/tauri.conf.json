{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepScreen Viewer",
  "version": "0.1.0",
  "identifier": "com.deepscreen.viewer",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepScreen Viewer",
        "width": 1340,
        "height": 880,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["../models/*.onnx", "../ffmpeg/*", "../README-TESTER.txt"]
  }
}
